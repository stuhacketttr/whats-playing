# Copy this file to ".env" (same folder) and fill in your keys. Never share .env.

# Optional. shazam-api.com key (from your dashboard). Only used when you click
# "Try shazam-api.com" after ShazamIO misses a clip; it uses paid credits.
SHAZAM_API_KEY=

# Optional, free. GetSongBPM key for looking up published BPM and key: https://getsongbpm.com/api
# (GetSongBPM requires a visible link back to their site; the app shows it. They also ask private or
# in-development projects to get in touch with them when registering.)
# Without a key, BPM and key are estimated from the audio clip instead, and marked "est.".
GETSONGBPM_API_KEY=

# Only if the upload fails with a "missing file" style error: the multipart field name from the docs
SHAZAM_API_FILE_FIELD=file

# Clip length in seconds. Try 15 if matches are missed.
CLIP_SECONDS=10
CONTINUOUS_GAP_SECONDS=15

# Keep the last captured clip as last_clip.wav (playable in the app). Set to 0 to disable.
SAVE_LAST_CLIP=1
