# Keep Windows batch files CRLF (LF-only .bat files can break goto/call labels in cmd.exe)
*.bat text eol=crlf
*.cmd text eol=crlf
# Generated by tools/build_legal_files.py with CRLF so Notepad and the installer show them cleanly
TERMS.txt text eol=crlf
LICENSE text eol=crlf
# Source and docs: LF in the repo
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.iss text eol=crlf
